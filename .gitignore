node_modules/
dist/
.vite/
*.local

# The standalone game reads no environment variables. Keep any future local
# configuration private until an explicit integration boundary is designed.
.env
.env.*

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Local launcher config — hardcodes absolute machine paths
.claude/launch.json

# Large source assets belong in Git LFS, not here. See docs/ASSETS.md before
# committing the first .blend / .psd / raw texture.
*.blend
*.blend1
*.psd

# Never commit raw bulk-download folders or duplicate public assets. Curate
# only the exact runtime files under public/ and record each source in the
# asset manifest.
/Animations/
/avatar.vrm
/SourceAssets/**/*.html
/public/models/*.html
