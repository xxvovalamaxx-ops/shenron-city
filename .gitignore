# The standalone game reads no environment variables. Keep any future local
# configuration private until an explicit integration boundary is designed.
.env
.env.*

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Local launcher config â€” hardcodes absolute machine paths
.claude/launch.json

# Large source assets belong in Git LFS, not here. See docs/ASSETS.md before
# committing the first .blend / .psd / raw texture.
*.blend
*.blend1
*.psd
!SourceAssets/Models/Characters/Source/Capybara/capybara_rigged.blend

# Never commit raw bulk-download folders or duplicate public assets. Curate
# only the exact runtime files under public/ and record each source in the
# asset manifest.
/Animations/
/avatar.vrm
/SourceAssets/**/*.html
/public/models/*.html

# Local authoring library. These folders can contain licensed source files and
# gigabytes of working data; tracked catalogs and READMEs describe them without
# republishing the binaries in normal Git history.
/SourceAssets/Animations/Raw/
/SourceAssets/Models/**/Raw/
/SourceAssets/Models/**/Working/
!/SourceAssets/Models/Environment/Working/
/SourceAssets/Models/Environment/Working/*
!/SourceAssets/Models/Environment/Working/Shenzhen_City_Production_Pass_02.blend
!/SourceAssets/Models/Environment/Working/Japanese_Forest_Shrine_Realistic.blend
/SourceAssets/Textures/Raw/
/SourceAssets/Audio/Raw/
/.asset-restore-*/

# Standalone local authoring projects, not part of the game repo.
/Made assets/Manhattan City/
/Made assets/brick building/

# Local-only shrine review material. The user's reference pixels and raw
# grading intermediates are never redistributed.
/docs/Assets/Previews/LocalValidation/
/docs/Assets/Previews/Final/Raw/
/docs/Assets/Previews/Final/*.log
/docs/Assets/Previews/Final/*.pid
/docs/Assets/Previews/japanese-forest-shrine-*-test.png
/docs/Assets/Previews/japanese-forest-shrine-clay.png
/docs/Assets/Previews/japanese-forest-shrine-realistic.png

*.log
!/SourceAssets/Museum/asset_museum.blend

