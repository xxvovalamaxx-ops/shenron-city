{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shenron-city.invalid/schemas/data-sources-lock.schema.json",
  "title": "Locked Manhattan compiler sources",
  "type": "object",
  "additionalProperties": false,
  "required": ["lockVersion", "sources"],
  "properties": {
    "$schema": { "type": "string" },
    "lockVersion": { "const": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "datasetName",
          "publisher",
          "versionOrRetrievalDate",
          "sourceFile",
          "sha256",
          "originalCrs",
          "groundElevationVerticalDatum",
          "groundElevationDatumRelation",
          "licenseNote",
          "normalizationScriptVersion"
        ],
        "properties": {
          "sourceId": { "type": "string", "minLength": 1 },
          "datasetName": { "type": "string", "minLength": 1 },
          "publisher": { "type": "string", "minLength": 1 },
          "versionOrRetrievalDate": { "type": "string", "minLength": 1 },
          "sourceFile": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "originalCrs": { "type": "string", "minLength": 1 },
          "groundElevationVerticalDatum": { "type": "string", "minLength": 1 },
          "groundElevationDatumRelation": { "const": "same-as-hq-anchor" },
          "licenseNote": { "type": "string", "minLength": 1 },
          "normalizationScriptVersion": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
