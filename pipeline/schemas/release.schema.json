{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shenron-city.invalid/schemas/release.schema.json",
  "title": "Phase 1 compiler release descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceHash",
    "normalizedDerivationSha256",
    "tilesetUri",
    "gameplayManifestUri",
    "requiredInitialTileIds"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sourceHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "normalizedDerivationSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "tilesetUri": { "const": "tileset.json" },
    "gameplayManifestUri": { "const": "gameplay/manifest.json" },
    "requiredInitialTileIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[1-9][0-9]*_[pm][0-9]{3}_[pm][0-9]{3}$" }
    }
  }
}
