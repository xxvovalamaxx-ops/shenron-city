{
  "name": "shenron-city",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "description": "Shenron City — a standalone walkable 3D headquarters prototype",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "verify:standalone": "node scripts/verify-standalone-build.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run verify:standalone",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dgreenheck/ez-tree": "^1.1.0",
    "@pixiv/three-vrm": "^3.5.5",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@react-three/rapier": "^2.2.0",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "three": "^0.185.1",
    "yuka": "^0.7.8",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.4.2",
    "@gltf-transform/core": "^4.4.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.4",
    "playwright": "^1.62.0",
    "typescript": "~5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "license": "UNLICENSED"
}
