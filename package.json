{
  "name": "shenron-city",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "description": "Shenzhen City — a standalone walkable 3D headquarters experience",
  "scripts": {
    "dev": "vite",
    "generate:manhattan-tiles": "node scripts/generate-manhattan-tiles.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "verify:standalone": "node scripts/verify-standalone-build.mjs",
    "verify:assets": "node scripts/verify-manhattan-assets.mjs && node scripts/verify-environment-authoring.mjs && node scripts/verify-night-environment-asset.mjs && node scripts/verify-japanese-forest-shrine-source.mjs",
    "catalog:public-library": "node scripts/assets/catalog-public-library.mjs",
    "verify:public-library": "node scripts/assets/verify-public-library.mjs",
    "inspect:production-assets": "node scripts/assets/inspect-gltf.mjs",
    "verify:production-manifest": "node scripts/assets/verify-manifest.mjs",
    "audit:production-scene": "node scripts/assets/scene-audit.mjs",
    "report:production-assets": "node scripts/assets/report-scene-assets.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run verify:assets && npm run verify:production-manifest && npm run verify:public-library && npm run audit:production-scene && npm run build && npm run verify:standalone && npm audit --audit-level=high",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-manhattan.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dgreenheck/ez-tree": "^1.1.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "three": "^0.185.1",
    "three-mesh-bvh": "^0.8.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "puppeteer-core": "^25.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "license": "UNLICENSED"
}
