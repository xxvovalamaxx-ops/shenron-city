* text=auto
# Keep reviews and merges stable across Windows and GitHub runners.
.gitattributes text eol=lf
.gitignore text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.csv text eol=lf
*.ps1 text eol=lf
*.py text eol=lf
*.ts text eol=lf diff
*.tsx text eol=lf diff
*.yml text eol=lf
*.yaml text eol=lf
# Windows launchers should open naturally in cmd.exe.
*.bat text eol=crlf
# Future game and documentation assets are never line-normalized.
*.bin binary
*.fbx binary
*.glb binary
*.gltf binary
*.jpg binary
*.jpeg binary
*.ktx2 binary
*.mp3 binary
*.ogg binary
*.wav binary
*.png binary
*.otf binary
*.ttf binary
*.exr binary
*.webp binary
*.vrm binary
# Preserve the reviewed high-resolution reconstruction without inflating every
# normal Git clone. Exported GLBs and review PNGs remain directly browsable.
SourceAssets/Models/Characters/Source/Capybara/*.obj filter=lfs diff=lfs merge=lfs -text
SourceAssets/Models/Characters/Source/Capybara/capybara_rigged.blend filter=lfs diff=lfs merge=lfs -text
docs/Assets/Previews/**/*.png filter=lfs diff=lfs merge=lfs -text
docs/Assets/Previews/**/*.exr filter=lfs diff=lfs merge=lfs -text
SourceAssets/**/*.blend filter=lfs diff=lfs merge=lfs -text
SourceAssets/**/*.glb filter=lfs diff=lfs merge=lfs -text
SourceAssets/**/*.fbx filter=lfs diff=lfs merge=lfs -text
SourceAssets/**/*.exr filter=lfs diff=lfs merge=lfs -text
SourceAssets/**/*.hdr filter=lfs diff=lfs merge=lfs -text
