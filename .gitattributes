* text=auto
# Keep reviews and merges stable across Windows and GitHub runners.
.gitattributes text eol=lf
.gitignore text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.csv text eol=lf
*.ps1 text eol=lf
*.py text eol=lf
*.ts text eol=lf diff
*.tsx text eol=lf diff
*.yml text eol=lf
*.yaml text eol=lf
# Windows launchers should open naturally in cmd.exe.
*.bat text eol=crlf
# Future game and documentation assets are never line-normalized.
*.bin binary
*.fbx binary
*.glb binary
*.gltf binary
*.jpg binary
*.jpeg binary
*.ktx2 binary
*.mp3 binary
*.ogg binary
*.wav binary
*.png binary
*.otf binary
*.ttf binary
*.exr binary
*.webp binary
*.vrm binary
# Large binary assets go through LFS to keep the git pack small.
# 3D models
SourceAssets/**/*.blend filter=lfs diff=lfs merge=lfs -text
SourceAssets/**/*.glb filter=lfs diff=lfs merge=lfs -text
SourceAssets/**/*.gltf filter=lfs diff=lfs merge=lfs -text
SourceAssets/**/*.fbx filter=lfs diff=lfs merge=lfs -text
SourceAssets/**/*.obj filter=lfs diff=lfs merge=lfs -text
SourceAssets/**/*.abc filter=lfs diff=lfs merge=lfs -text
SourceAssets/**/*.vrm filter=lfs diff=lfs merge=lfs -text
# Textures & images
SourceAssets/**/*.png filter=lfs diff=lfs merge=lfs -text
SourceAssets/**/*.jpg filter=lfs diff=lfs merge=lfs -text
SourceAssets/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
SourceAssets/**/*.tif filter=lfs diff=lfs merge=lfs -text
SourceAssets/**/*.tiff filter=lfs diff=lfs merge=lfs -text
SourceAssets/**/*.exr filter=lfs diff=lfs merge=lfs -text
SourceAssets/**/*.hdr filter=lfs diff=lfs merge=lfs -text
SourceAssets/**/*.ktx2 filter=lfs diff=lfs merge=lfs -text
SourceAssets/**/*.webp filter=lfs diff=lfs merge=lfs -text
# Audio
SourceAssets/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
SourceAssets/**/*.ogg filter=lfs diff=lfs merge=lfs -text
SourceAssets/**/*.wav filter=lfs diff=lfs merge=lfs -text
# Unreal & other binary
SourceAssets/**/*.uasset filter=lfs diff=lfs merge=lfs -text
SourceAssets/**/*.umap filter=lfs diff=lfs merge=lfs -text
SourceAssets/**/*.bin filter=lfs diff=lfs merge=lfs -text
# Fonts
SourceAssets/**/*.otf filter=lfs diff=lfs merge=lfs -text
SourceAssets/**/*.ttf filter=lfs diff=lfs merge=lfs -text
# Video
SourceAssets/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
SourceAssets/**/*.mov filter=lfs diff=lfs merge=lfs -text
# Previews & exports
docs/Assets/Previews/** filter=lfs diff=lfs merge=lfs -text
public/models/** filter=lfs diff=lfs merge=lfs -text
public/assets/** filter=lfs diff=lfs merge=lfs -text
*.vrm filter=lfs diff=lfs merge=lfs -text
*.abc filter=lfs diff=lfs merge=lfs -text
# The repository's GitHub LFS upload budget is exhausted (2026-09-24), so
# runtime models added or re-baked since then ship as ordinary git blobs.
# Each is a few MB at most; existing LFS assets are unchanged. Move these back
# under LFS (git lfs migrate import --include=...) once the budget is raised.
public/models/characters/player/player-clips.glb -filter -diff -merge binary
public/models/vehicles/** -filter -diff -merge binary
public/models/people/** -filter -diff -merge binary
public/models/trees/** -filter -diff -merge binary
